NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sharad_utsav_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=sharad_utsav
MYSQL_POOL_SIZE=10
# Enable for deployed MySQL providers; provide MYSQL_SSL_CA when a private CA is needed.
MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/provider-ca.pem
# Existing JSON bookings are imported once at startup if this file exists.
# BOOKING_STORE_PATH=./data/booking-store.json
